# Copy to .env AND server/.env. Never commit real secrets.
# Brand defaults also load from ../config/brand.json when env keys are empty.
# Free-first map: ../docs/INTEGRATIONS_CATALOG.md · ../config/integrations.status.json

# --- Database ---
# Local Docker: postgresql://outbound:outbound@localhost:5433/localpresence_outbound?schema=public
# Neon free (project halloway-associates): paste pooled URL from console.neon.tech
DATABASE_URL="postgresql://outbound:outbound@localhost:5433/localpresence_outbound?schema=public"

# --- Redis (optional on free tier) ---
# Prefer SYNC_JOBS=true to avoid Upstash until needed
REDIS_URL="redis://localhost:6379"
SYNC_JOBS="true"

# --- Auth (built-in JWT — free; Clerk optional later) ---
OPERATOR_EMAIL="jadisselantaki@hallowayassociates.com"
OPERATOR_PASSWORD="change-me-now"
JWT_SECRET="replace-with-long-random-string-min-24-chars"
SESSION_TTL_HOURS="168"
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# --- App ---
PORT="3001"
HOST="0.0.0.0"
CORS_ORIGIN="http://localhost:5174,http://localhost:5173,https://hallowayassociates.com"
NODE_ENV="development"
DRY_RUN="true"
LOG_EMAIL_BODIES="false"

# --- Brand ---
BRAND="Halloway Associates"
FOUNDER_NAME="Jadiss Elantaki"
CITY="Grèce"
CONTACT_EMAIL="jadisselantaki@hallowayassociates.com"
CONTACT_PHONE=""
SITE_URL="https://hallowayassociates.com"
UNSUBSCRIBE_BASE_URL="http://localhost:3001/api/public/unsubscribe"

# --- Email (Layer 1 free Resend — keep dry-run until GO_LIVE) ---
EMAIL_PROVIDER="dry-run"
# EMAIL_PROVIDER=resend | smtp | dry-run
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# --- AI (not free — leave empty; mock works) ---
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# --- Lead discovery (optional; mock when empty) ---
GOOGLE_PLACES_API_KEY=""
HUNTER_API_KEY=""
APOLLO_API_KEY=""
DROPCONTACT_API_KEY=""
SERPAPI_KEY=""
TAVILY_API_KEY=""

# --- Email alts (free tiers; still keep dry-run) ---
BREVO_API_KEY=""
LOOPS_API_KEY=""

# --- Payments (Stripe test mode free to connect) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""

# --- Ops / CRM / chat alerts (free) ---
SLACK_WEBHOOK_URL=""
DISCORD_WEBHOOK_URL=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
SENTRY_DSN=""
NOTION_TOKEN=""
LINEAR_API_KEY=""
HUBSPOT_TOKEN=""
AIRTABLE_API_KEY=""
AIRTABLE_BASE_ID=""

# --- Media / CMS (client delivery free tiers) ---
CLOUDINARY_URL=""
SANITY_PROJECT_ID=""
SANITY_DATASET=""
TURNSTILE_SECRET_KEY=""
NGROK_AUTHTOKEN=""

# --- Compliance ---
DEFAULT_DAILY_CAP="40"
WARM_UP_DAILY_CAP="10"
REQUIRE_WEBSITE="false"
EXCLUDE_FREE_EMAIL_DOMAINS="false"

# --- Webhooks (required in production) ---
WEBHOOK_SECRET=""
